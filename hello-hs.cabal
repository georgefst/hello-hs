cabal-version: 3.0
name: hello-hs
version: 0.1.0.0
license-file: LICENSE
author: George Thomas
maintainer: georgefsthomas@gmail.com

executable hello-hs
    main-is: Main.hs
    hs-source-dirs: app
    other-modules:
        ColouredOBJ
        DiagramsGloss
        DiagramsWaterfall
        LondonHaskell
        Undegenerate
        WaterfallDice
    default-language: GHC2024
    default-extensions:
        BlockArguments
        DerivingStrategies
        DerivingVia
        DuplicateRecordFields
        LexicalNegation
        MultilineStrings
        NamedFieldPuns
        NegativeLiterals
        NoFieldSelectors
        NoMonomorphismRestriction
        OrPatterns
        OverloadedLabels
        OverloadedRecordDot
        PartialTypeSignatures
        RecordWildCards
        ViewPatterns
    ghc-options:
        -threaded
        -Wall
    build-depends:
        base >=4.14,
        bytestring,
        colour,
        containers,
        diagrams-core,
        diagrams-lib,
        diagrams-svg,
        directory,
        extra,
        filepath,
        gloss,
        lens,
        linear,
        opencascade-hs,
        pretty-simple,
        svg-builder,
        text,
        waterfall-cad-svg,
        waterfall-cad,
